{# This is right below the 'forgot password' #}

<hr />

{% if loginFailedMessage %}
    <div vue-entry="CoreHome.Notification"
         noclear="true"
         context="error">
        <strong>{{ 'General_Error'|translate }}</strong>: {{ loginFailedMessage }}<br/>
    </div>
{% endif %}

<div class="center-align">
    <form method="post" action="{{ linkTo({'module': 'RebelOIDC', 'action': 'signIn'}) }}">
        <input type="hidden" name="form_nonce" value="{{ nonce }}" />
        <button class="btn loginoidc-auth-button" type="submit">
            {{ caption }}
        </button>
    </form>
</div>
